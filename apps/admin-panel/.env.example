API_BASE_URL=http://localhost:5000/api/v1
# Required for stable staging/production domains. Ephemeral Vercel previews use
# VERCEL_URL only when this variable is intentionally unset for that branch.
NEXT_PUBLIC_APP_URL=http://localhost:3002
DASHBOARD_BFF_SECRET=replace-with-the-same-32-character-secret-as-the-backend
DASHBOARD_ENVIRONMENT=development
DASHBOARD_RELEASE=local
# Must name a client-IP header that your trusted reverse proxy overwrites and
# strips from incoming traffic. Never point this at a client-controlled header.
DASHBOARD_TRUSTED_CLIENT_IP_HEADER=x-vercel-forwarded-for
