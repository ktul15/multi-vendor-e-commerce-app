{
  "name": "@repo/test-utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src test vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@repo/query": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@testing-library/react": "16.3.2",
    "msw": "2.15.0",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@types/react": "19.2.18",
    "jsdom": "30.0.1",
    "vitest": "4.1.10"
  }
}
