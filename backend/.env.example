# Environment
NODE_ENV=development
PORT=5000
APP_ENVIRONMENT=development
APP_RELEASE=local

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/multivendor_ecommerce?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (production requires distinct secrets of at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-distinct-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-distinct-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
DASHBOARD_BFF_SECRET=replace-with-the-same-32-character-secret-as-the-dashboards

# Web auth cookies are always HttpOnly + Secure + SameSite=Lax.
# Use HTTPS for dashboard/API origins, including local browser testing.

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your-connect-webhook-secret

# Stripe Connect (must be HTTP(S) URLs on VENDOR_DASHBOARD_URL)
PLATFORM_COMMISSION_RATE=10.00
STRIPE_CONNECT_RETURN_URL=http://localhost:3001/stripe/return
STRIPE_CONNECT_REFRESH_URL=http://localhost:3001/stripe/refresh

# Razorpay Test Mode / Route. Leave mock enabled when the test account does
# not have Route access; mock identifiers and signatures are deterministic.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
# Required when RAZORPAY_SANDBOX_MOCK=false.
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
RAZORPAY_SANDBOX_MOCK=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Firebase (FCM)
FIREBASE_SERVICE_ACCOUNT=path/to/serviceAccountKey.json

# Exact browser origins (CORS). Production requires all three values and HTTPS.
# Use only scheme + host + optional port: no paths, query strings, or wildcards.
STOREFRONT_URL=http://localhost:3000
VENDOR_DASHBOARD_URL=http://localhost:3001
ADMIN_DASHBOARD_URL=http://localhost:3002
